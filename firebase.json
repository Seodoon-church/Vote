{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "vote",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "hosting": {
    "site": "seodoon-vote",
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true
  },
  "emulators": {
    "firestore": {
      "port": 8092
    },
    "auth": {
      "port": 9092
    },
    "functions": {
      "port": 5092
    },
    "ui": {
      "enabled": true
    }
  }
}
